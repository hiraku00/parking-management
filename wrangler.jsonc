{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parking-management",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  // Version Preview URLs are served from a different hostname than the
  // deployed Worker, so Access（/admin*）はそこには効かない。無効にしておく。
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parking",
      "database_id": "735518af-6aa6-45ea-aacc-843aa8dab5e5",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "frosty-rice-fb39.cloudflareaccess.com",
    "ACCESS_AUD": "f4eca92090a94673a132a6398514fe4a886310f9dbcf6fe1af50c3dc400bb8ae",
    "OWNER_EMAILS": "hiraku00@gmail.com",
    // 本番では常に空。ローカルの .dev.vars でだけ値を入れ、Access をバイパスする
    // （lib/auth/owner.ts）。ここに書くのは、CIなど .dev.vars が無い環境でも
    // `wrangler types` がこのキーの型を生成できるようにするため。
    "DEV_OWNER_EMAIL": "",
  },
}
