# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/dist
/build
/.next/
/out/
/coverage
/playwright-report/
/test-results/

# Cloudflare / wrangler / vinext
/.wrangler/
/.vinext/
.dev.vars
.dev.vars.*
!.dev.vars.example
worker-configuration.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets are never committed — this is a public repository)
.env
.env.*
!.env.example
!.env*.example

# vercel (legacy, kept in case of temporary rollback tooling)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/*
!.vscode/extensions.json
.idea
